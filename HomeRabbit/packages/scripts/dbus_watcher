#!/bin/bash
#/usr/scripts/dbus_watcher

source /usr/www/cgi-bin/setup.inc
source /usr/www/cgi-bin/utils.inc
source /usr/www/cgi-bin/leds.inc

# Variables globales
RFID_DETECTED=0
SOUND1="twang_01.mp3"
SOUND2="twang_04.mp3"

# Nettoyage des processus existants
killall dbus-monitor 2>/dev/null

# Démarrage du moniteur DBUS
dbus-monitor --system | while read -r line; do
    # ---------------------
    # GESTION BOUTONS
    # ---------------------
    
    # Long Click - Mode enregistrement
    if echo "$line" | grep -q "member=lclick_start"; then
        KillProcess
        if [ -e "$CNF_DATADIR/Run/rfid.record" ]; then 
            StopTagRecording
        else
            StartTagRecording
        fi
        continue
    fi

    # Simple Click
    if echo "$line" | grep -q "member=click"; then
        if ls /mnt/usbkey/*.mp3 1>/dev/null 2>&1; then
            # Lecture du fichier mp3 avec madplay (volume ajustable avec la variable VOLUME)
            CHECK=$(IsSoundPlaying)
            if [ $CHECK -eq 0 ]; then
                PlaySoundEx /mnt/usbkey/*.mp3 1 >>/dev/null 2>>/dev/null
            else
                KillProcess SOUNDS
            fi
        else
            # Si aucun .mp3 trouvé, comportement par défaut
            PlaySound "$CNF_DATADIR/Sounds/${SOUND2}"
            /www/cgi-bin/apps/moods &
        fi
        continue
    fi

    # Double Click
    if echo "$line" | grep -q "member=dclick"; then
        PlaySound "$CNF_DATADIR/Sounds/${SOUND1}"
        /www/cgi-bin/apps/tai-chi &
        continue
    fi

    # Triple Click
    if echo "$line" | grep -q "member=tclick"; then
        PlaySound "$CNF_DATADIR/Sounds/flush.mp3"
        #/sbin/reboot
        KillProcess
        continue
    fi

    # ---------------------
    # GESTION RFID
    # ---------------------
    
    # Détection d'un tag
    if echo "$line" | grep -q "tag_in"; then
        RFID_DETECTED=1
        continue
    fi

    # Lecture de l'ID du tag
    if [ $RFID_DETECTED -eq 1 ]; then
        RFID_ID=$(echo "$line" | awk -F\" '{print $2}')
        if [ -n "$RFID_ID" ]; then
            if [ -e "$CNF_DATADIR/Run/rfid.record" ]; then 
                RFID_DETECTED=2
            else
                RFID_DETECTED=7
            fi
        fi
        continue
    fi

    # Lecture du type
    if [ $RFID_DETECTED -eq 2 ]; then
        RFID_TYPE=$(echo "$line" | awk -F\  '{print $2}')
        if [ -n "$RFID_TYPE" ]; then
            GetRfidTypeName "$RFID_TYPE"
            RFID_DETECTED=3
        fi
        continue
    fi

    # Lecture de la couleur
    if [ $RFID_DETECTED -eq 3 ]; then
        RFID_COLOR=$(echo "$line" | awk -F\  '{print $2}')
        if [ -n "$RFID_COLOR" ]; then
            RFID_DETECTED=4
        fi
        continue
    fi

    # Traitement final
    if [ $RFID_DETECTED -eq 4 ] || [ $RFID_DETECTED -eq 7 ]; then
        # Mode enregistrement
        if [ -e "$CNF_DATADIR/Run/rfid.record" ]; then
            if [ -e "$CNF_DATADIR/Rfid/${RFID_ID}.rfid" ]; then
                PlaySound "$CNF_DATADIR/Sounds/rfid_error.mp3"
                PlaySound "$CNF_DATADIR/Voice/Rfid_objet_deja_enregistre.mp3"
            else
                echo "" > "$CNF_DATADIR/Rfid/${RFID_ID}.rfid"
                echo "$RFID_COLOR" > "$CNF_DATADIR/Rfid/${RFID_ID}.color"
                echo "$RFID_TYPE"  > "$CNF_DATADIR/Rfid/${RFID_ID}.type"
                PlaySound "$CNF_DATADIR/Sounds/rfid_ok.mp3" 
                PlaySound "$CNF_DATADIR/Voice/Rfid_objet_enregistre.mp3"
            fi
        # Mode suppression
        elif [ -e "$CNF_DATADIR/Run/rfid.delete" ]; then
            PlaySound "$CNF_DATADIR/Voice/Rfid_objet_supprime.mp3" 
            rm -f "$CNF_DATADIR/Rfid/$RFID_ID.*"
        # Mode normal
        else
            if [ -e "$CNF_DATADIR/Rfid/${RFID_ID}.rfid" ]; then
                if [ ! -e "$CNF_DATADIR/Rfid/${RFID_ID}.action" ]; then
                    if [ ! -e "$CNF_DATADIR/Run/karotz.sleep" ]; then
                        PlaySound "$CNF_DATADIR/Sounds/rfid_error.mp3"
                        PlaySound "$CNF_DATADIR/Voice/Rfid_objet_pas_action.mp3"
                    fi
                else
                    Leds FF0000 000000 0 1
                    PlaySound $CNF_DATADIR/Sounds/rfid_ok.mp3
                    if [ ! -e "$CNF_DATADIR/Run/karotz.sleep" ]; then
                        PlaySound "$CNF_DATADIR/Sounds/${SOUND1}"
                    fi
                    SCENE_ID=$(cat "$CNF_DATADIR/Rfid/${RFID_ID}.rfid")
                    SCENE_CMD=$(cat "$CNF_DATADIR/Rfid/${RFID_ID}.cmd")
                    Log "[Rfid]" "Calling external action : $(GetCmdName $SCENE_CMD)"
                    LedsRestore
                    eval $(cat "$CNF_DATADIR/Rfid/${RFID_ID}.action" | busybox base64 -d)
                fi
            else
                if [ ! -e "$CNF_DATADIR/Run/karotz.sleep" ]; then
                    PlaySound "$CNF_DATADIR/Sounds/rfid_error.mp3"
                    PlaySound "$CNF_DATADIR/Voice/Rfid_Object_inconnu.mp3"
                fi
            fi
        fi
        RFID_DETECTED=0
        continue
    fi
done