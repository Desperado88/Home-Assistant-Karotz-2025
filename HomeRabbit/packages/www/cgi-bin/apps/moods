#!/bin/bash
# Redirige les erreurs vers /dev/null pour éviter toute sortie parasite CGI
exec 2>/dev/null
# joue une humeur aléatoire avec le mouvement qui correspond

# Inclusion des fichiers de configuration et des fonctions utilitaires
source /usr/www/cgi-bin/setup.inc
source /usr/www/cgi-bin/url.inc
source /usr/www/cgi-bin/utils.inc
source /usr/www/cgi-bin/ears.inc
source /usr/www/cgi-bin/leds.inc

# Sauvegarde de l'état actuel de la LED et des oreilles
LedsSave
EarsSave

# Log de l'appel du script Moods
#Log "[MOODS]" "Moods Called"

# Arrêt des processus LEDS et SOUNDS si actifs
KillProcess LEDS
KillProcess SOUNDS
# Lecture des paramètres passés dans l'URL
ReadUrlParam

# Vérification de l'existence des dossiers nécessaires pour les humeurs
CheckMandatoryDirectory  "$CNF_DATADIR/Moods"
CheckMandatoryDirectory  "$CNF_DATADIR/Moods/fr"

# Récupération de l'ID de l'humeur et de la langue depuis les paramètres URL
MOODS_ID=${URLParam[id]:-}
LANG=${URLParam[lang]:-fr}

# Choix de l'humeur
if [ -z "$MOODS_ID" ]; then
    MOODS=$(( RANDOM % 305 ))
else
    MOODS=$MOODS_ID
fi

MP3_FILE="$CNF_DATADIR/Moods/fr/${MOODS}.mp3"

if [ ! -e "$MP3_FILE" ]; then
  DATA='{"return":"1","msg":"Moods not found"}'
  SendResponse "$DATA"
  exit 0
fi

if [ ! -e "$CNF_DATADIR/Run/karotz.sleep" ]; then
   EarsReset
   PlaySound "$MP3_FILE"
   case "$MOODS" in
      1)  /usr/www/cgi-bin/apps/moods_1 & ;;
      2)  /usr/www/cgi-bin/apps/moods_2 & ;;
      3)  /usr/www/cgi-bin/apps/moods_3 & ;;
      5)  /usr/www/cgi-bin/apps/moods_5 & ;;
      8)  /usr/www/cgi-bin/apps/moods_8 & ;;
      15) /usr/www/cgi-bin/apps/moods_15 & ;;
      16) /usr/www/cgi-bin/apps/moods_16 & ;;
      17) /usr/www/cgi-bin/apps/moods_17 & ;;
      18) /usr/www/cgi-bin/apps/moods_18 & ;;
      19) /usr/www/cgi-bin/apps/moods_19 & ;;
      21) /usr/www/cgi-bin/apps/moods_21 & ;;
      24) /usr/www/cgi-bin/apps/moods_24 & ;;
      25) /usr/www/cgi-bin/apps/moods_25 & ;;
      26) /usr/www/cgi-bin/apps/moods_26 & ;;
      27) /usr/www/cgi-bin/apps/moods_27 & ;;
      28|33) /usr/www/cgi-bin/apps/moods_28 & ;;
      29) /usr/www/cgi-bin/apps/moods_29 & ;;
      31) /usr/www/cgi-bin/apps/moods_31 & ;;
      32) /usr/www/cgi-bin/apps/moods_32 & ;;
      34) /usr/www/cgi-bin/apps/moods_34 & ;;
      37) /usr/www/cgi-bin/apps/moods_37 & ;;
      59) /usr/www/cgi-bin/apps/moods_59 & ;;
      60|61) /usr/www/cgi-bin/apps/moods_60 & ;;
      65) /usr/www/cgi-bin/apps/moods_65 & ;;
      73) /usr/www/cgi-bin/apps/moods_73 & ;;
      81) /usr/www/cgi-bin/apps/moods_81 & ;;
      82|86) /usr/www/cgi-bin/apps/moods_82 & ;;
      97) /usr/www/cgi-bin/apps/moods_97 & ;;
      99) /usr/www/cgi-bin/apps/moods_99 & ;;
      100) /usr/www/cgi-bin/apps/moods_100 & ;;
      101) /usr/www/cgi-bin/apps/moods_101 & ;;
      111|112|122) /usr/www/cgi-bin/apps/moods_111 & ;;
      130|131|299) /usr/www/cgi-bin/apps/moods_130 & ;;
      144) /usr/www/cgi-bin/apps/moods_144 & ;;
      256) /usr/www/cgi-bin/apps/moods_256 & ;;
      268) /usr/www/cgi-bin/apps/moods_268 & ;;
      *)  /usr/www/cgi-bin/apps/moods_default & ;;
   esac
   DATA='{"moods":"'$MOODS'","return":"0"}'
else
   DATA='{"return":"1","msg":"Unable to perform action, rabbit is sleeping."}'
fi

# Sauvegarde de la dernière action exécutée
# (rejouable localement avec le bon paramètre)
echo "QUERY_STRING=\"id=$MOODS\" ./apps/moods" > /www/cgi-bin/karotz_last_action.sh
chmod +x /www/cgi-bin/karotz_last_action.sh

# Restauration de l'état de la LED et des oreilles
LedsRestore
EarsRestore

# Envoie la réponse JSON au client
SendResponse "$DATA"
