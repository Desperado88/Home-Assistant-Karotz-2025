#!/bin/bash

# Script pour gérer le volume du Karotz
# Utilisation : /cgi-bin/volume?level=X
# X doit être un pourcentage entre 0 et 100
# 100% = 0 dB (volume maximum)
# 0% = -30 dB (volume minimum)

source /usr/www/cgi-bin/utils.inc

# Création du dossier de configuration s'il n'existe pas
mkdir -p /usr/karotz/config

# Récupération du pourcentage depuis l'URL
PERCENTAGE=$(echo "$QUERY_STRING" | sed 's/.*level=\([^&]*\).*/\1/')

# Vérification que le pourcentage est un nombre
if ! echo "$PERCENTAGE" | grep -qE '^[0-9]+$'; then
    echo "Content-type: text/plain"
    echo
    echo "Erreur: Le niveau doit être un pourcentage entre 0 et 100"
    exit 1
fi

# Vérification des limites (0 à 100)
if [ "$PERCENTAGE" -lt 0 ] || [ "$PERCENTAGE" -gt 100 ]; then
    echo "Content-type: text/plain"
    echo
    echo "Erreur: Le pourcentage doit être entre 0 et 100"
    exit 1
fi

# Conversion du pourcentage en décibels
# Formule : db = ((100 - percentage) / 100 * -30)
VOLUME=$(echo "$PERCENTAGE 100 -30" | awk '{printf "%.0f", (100 - $1) * $3 / 100}')

# Sauvegarde du volume dans le fichier de configuration
echo "$VOLUME" > /usr/karotz/config/volume

# Jouer un son de test avec le nouveau volume
SOUND_FILE="/usr/openkarotz/Sounds/saut1.mp3"
if [ -f "$SOUND_FILE" ]; then
    KillProcess SOUNDS
    sleep 0.5
    madplay --adjust-volume=$VOLUME "$SOUND_FILE" >/dev/null 2>&1
fi

# Réponse HTTP
echo "Content-type: text/plain"
echo
echo "Volume réglé à $VOLUME dB ($PERCENTAGE%)"
