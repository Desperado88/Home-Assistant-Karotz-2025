#!/bin/bash

# info : $CNF_DATADIR="/usr/openkarotz"
# Script pour gerer le volume du Karotz
# Utilisation : /cgi-bin/volume?level=X
# X doit etre un pourcentage entre 0 et 100
# 100% = 0 dB (volume maximum)
# 0% = -30 dB (volume minimum)

source /usr/www/cgi-bin/utils.inc
source /www/cgi-bin/setup.inc
KillProcess SOUNDS

# Recuperation du pourcentage depuis l'URL
PERCENTAGE=$(echo "$QUERY_STRING" | sed 's/.*level=\([^&]*\).*/\1/')

# Verification que le pourcentage est un nombre
if ! echo "$PERCENTAGE" | grep -qE '^[0-9]+$'; then
    DATA='{"return":"1","msg":"Le niveau doit etre un pourcentage entre 0 et 100"}'
    Log "[VOLUME]" "Erreur: Le niveau doit etre un pourcentage entre 0 et 100"
    SendResponse "$DATA"
    exit 1
fi

# Verification des limites (0 a 100)
if [ "$PERCENTAGE" -lt 0 ] || [ "$PERCENTAGE" -gt 100 ]; then
    DATA='{"return":"1","msg":"Le pourcentage doit etre entre 0 et 100"}'
    Log "[VOLUME]" "Erreur: Le pourcentage doit etre entre 0 et 100"
    SendResponse "$DATA"
    exit 1
fi

# Conversion du pourcentage en decibels
# Formule : db = ((100 - percentage) / 100 * -30)
VOLUME=$(echo "$PERCENTAGE 100 -30" | awk '{printf "%.0f", (100 - $1) * $3 / 100}')

# Vérification des limites en dB
if [ "$VOLUME" -lt -30 ]; then
    VOLUME=-30
elif [ "$VOLUME" -gt 0 ]; then
    VOLUME=0
fi

# Sauvegarde du volume dans le fichier de configuration /usr/openkarotz/Run/volume
echo "$VOLUME" > $CNF_DATADIR/Run/volume

# Verifie si le karotz est en veille
if [ ! -e "$CNF_DATADIR/Run/karotz.sleep" ]; then
    # Jouer un son de test avec le nouveau volume
    SOUND_FILE="$CNF_DATADIR/Sounds/saut1.mp3"
    if [ -f "$SOUND_FILE" ]; then
        sleep 0.5
        madplay --adjust-volume=$VOLUME "$SOUND_FILE" >/dev/null 2>&1
    fi
fi
# Reponse HTTP en JSON
DATA='{"return":"0","msg":"Volume regle a '$VOLUME' dB ('$PERCENTAGE'%)"}'
Log "[VOLUME]" "Volume regle a $VOLUME dB ($PERCENTAGE%)"
SendResponse "$DATA"
