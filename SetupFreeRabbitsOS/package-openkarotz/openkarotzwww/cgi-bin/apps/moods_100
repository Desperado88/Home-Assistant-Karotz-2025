#!/bin/bash
# Animation mood 100 - "Y a de l’écho... ça doit venir de mes oreilles."

# Inclusion des fichiers de configuration et fonctions
source /usr/www/cgi-bin/setup.inc
source /usr/www/cgi-bin/url.inc
source /usr/www/cgi-bin/utils.inc
source /usr/www/cgi-bin/ears.inc
source /usr/www/cgi-bin/leds.inc

# Initialisation
#EarsReset
Leds 00FFFF 000000 1 1 700  # LED cyan pulsante pour confusion légère
sleep 1

# Phase 1 (0–5s) : oreilles en rotation alternée, effet “j’écoute mal”
EarsMove 6 12 50
sleep 1
EarsMove 12 6 50
sleep 1
EarsMove 6 12 50
sleep 1
EarsMove 12 6 50
sleep 2

# Phase 2 (5–11s) : oreilles s’ouvrent/ferment comme “antennes”
Leds 0000FF 000000 1 1 400  # LED bleue plus marquée
EarsMove 3 13 60
sleep 1
EarsMove 13 3 60
sleep 1
EarsMove 4 12 60
sleep 1
EarsMove 12 4 60
sleep 1
EarsMove 8 8 60
sleep 1

# Phase 3 (11–17s) : on s'agite un peu pour trouver la source de l’écho
Leds FF0000 000000 1 1 300  # rouge léger (agacement)
EarsMove 6 6 80
sleep 0.5
EarsMove 10 10 80
sleep 0.5
EarsMove 8 8 80
sleep 1
EarsMove 6 6 80
sleep 1

# Retour au calme
EarsReset
Leds 00FF00 000000 1 1 1000
sleep 1

DATA='{"return":"0","msg":"Mood 100 animation complete."}'
SendResponse "$DATA"
